{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ucount-website",
  "compatibility_date": "2026-04-15",
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
  // Non-secret Wix identifiers (site id, contact form id and field targets)
  // live in src/lib/wix-config.ts. Privileged API keys are Worker secrets.
}
