# Server-only privileged API keys. Never expose them to browser code.
# These are the only values required to run against the live Wix site. Set them
# as Worker secrets when deploying, never as plaintext variables. The forms key
# needs the Wix Forms "Manage Form Submissions" permission.
WIX_DATA_API_KEY=""
WIX_EVENTS_API_KEY=""
WIX_STORES_API_KEY=""
WIX_FORMS_API_KEY=""

# Optional: set if Wix-managed checkout pages live on a different domain than
# the Astro site. Example: "https://checkout.example.org".
WIX_CHECKOUT_BASE_URL=""

# Everything below is optional. The non-secret Wix identifiers default to the
# official site's values in src/lib/wix-config.ts; set them here only to point a
# local run or a staging deployment at a different Wix site or form.
#
#   WIX_SITE_ID
#   WIX_CONTACT_FORM_ID
#   WIX_CONTACT_FIELD_FIRST_NAME
#   WIX_CONTACT_FIELD_LAST_NAME
#   WIX_CONTACT_FIELD_EMAIL
#   WIX_CONTACT_FIELD_MESSAGE
#   WIX_CMS_COLLECTION_ALIASES
