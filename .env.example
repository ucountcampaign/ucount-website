WIX_SITE_ID=""

# Server-only privileged API keys. Never expose them to browser code.
WIX_DATA_API_KEY=""
WIX_EVENTS_API_KEY=""
WIX_STORES_API_KEY=""
WIX_FORMS_API_KEY=""

# Optional: set if Wix-managed checkout pages live on a different domain than
# the Astro site. Example: "https://checkout.example.org".
WIX_CHECKOUT_BASE_URL=""

# Required for the Astro contact form to submit into Wix Forms.
# The forms key needs the Wix Forms "Manage Form Submissions" permission.
WIX_CONTACT_FORM_ID="1a784f54-c174-4349-8d67-7dbf93214af5"

# Field targets from the "Astro Contact Form" Wix form schema.
WIX_CONTACT_FIELD_FIRST_NAME="first_name_5b78"
WIX_CONTACT_FIELD_LAST_NAME="last_name_3ab0"
WIX_CONTACT_FIELD_EMAIL="email_df1a"
WIX_CONTACT_FIELD_MESSAGE="message"

# Optional JSON map for official Wix sites where manually-created CMS collections
# have immutable IDs such as "Import1".
WIX_CMS_COLLECTION_ALIASES='{"SiteSettings":"Import1"}'
