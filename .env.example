WIX_CLIENT_ID=""
WIX_SITE_ID=""

# Only set this for server-side privileged API calls. Never expose it to browser code.
WIX_API_KEY=""

# Optional: set if Wix-managed checkout pages live on a different domain than
# the Astro site. Example: "https://checkout.example.org".
WIX_CHECKOUT_BASE_URL=""

# Optional: required for the Astro contact form to submit into Wix Forms.
# The API key also needs the Wix Forms "Manage Submissions" permission.
WIX_CONTACT_FORM_ID=""
WIX_CONTACT_FIELD_FIRST_NAME="first_name"
WIX_CONTACT_FIELD_LAST_NAME="last_name"
WIX_CONTACT_FIELD_EMAIL="email"
WIX_CONTACT_FIELD_MESSAGE="message"

# Optional JSON map for official Wix sites where manually-created CMS collections
# have immutable IDs such as "Import1".
WIX_CMS_COLLECTION_ALIASES='{"SiteSettings":"Import1"}'
