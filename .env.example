# Server-only privileged API keys. Never expose them to browser code.
# Set them as Worker secrets when deploying, never as plaintext variables. The
# forms key needs the Wix Forms "Manage Form Submissions" permission.
WIX_DATA_API_KEY=""
WIX_EVENTS_API_KEY=""
WIX_FORMS_API_KEY=""

# Square powers the marketplace: catalog and inventory reads plus hosted
# Payment Link checkout. The access token needs catalog, inventory, and orders
# permissions. Set SQUARE_ENVIRONMENT to "sandbox" to test against
# connect.squareupsandbox.com with a sandbox token; it defaults to production.
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
# SQUARE_ENVIRONMENT="sandbox"

# Everything below is optional. The non-secret Wix identifiers default to the
# official site's values in src/lib/wix-config.ts; set them here only to point a
# local run or a staging deployment at a different Wix site or form.
#
#   WIX_SITE_ID
#   WIX_CONTACT_FORM_ID
#   WIX_CONTACT_FIELD_FIRST_NAME
#   WIX_CONTACT_FIELD_LAST_NAME
#   WIX_CONTACT_FIELD_EMAIL
#   WIX_CONTACT_FIELD_MESSAGE
#   WIX_CMS_COLLECTION_ALIASES
