---
import type { ResolvedSiteSettings } from "../lib/wix-cms";
import SocialIcon from "./SocialIcon.astro";

type ActivePage = "home" | "about" | "contact" | "events" | "shop";

const { site, activePage } = Astro.props as {
  site: ResolvedSiteSettings;
  activePage: ActivePage;
};

const homeHref = (hash: string) => (activePage === "home" ? hash : `/${hash}`);
---

<footer class="bg-neutral-900 text-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-4 gap-12 lg:gap-8">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <img src="/assets/UCOUNT_logo_lockup_white.png" alt="U COUNT Campaign" class="h-[4.5rem] lg:h-[5.5rem] w-auto">
        </div>
        <p class="text-neutral-400 text-sm max-w-sm leading-relaxed mt-4">
          {site.organizationSummary}
        </p>
        <div class="flex items-center gap-4 mt-6">
          <a href={site.facebookUrl} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/5 hover:bg-ember-brand/20 flex items-center justify-center transition-colors group" aria-label="Facebook">
            <SocialIcon name="facebook" class="h-5 w-5 text-neutral-400 transition-colors group-hover:text-ember-brand" />
          </a>
          <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/5 hover:bg-ember-brand/20 flex items-center justify-center transition-colors group" aria-label="Instagram">
            <SocialIcon name="instagram" class="h-5 w-5 text-neutral-400 transition-colors group-hover:text-ember-brand" />
          </a>
        </div>
      </div>

      <div>
        <h3 class="font-display font-bold text-sm uppercase tracking-wider text-neutral-400 mb-4">Quick Links</h3>
        <ul class="space-y-2.5">
          <li><a href="/shop" class="text-sm text-neutral-400 hover:text-ember-brand transition-colors">Marketplace</a></li>
          <li><a href="/events" class="text-sm text-neutral-400 hover:text-ember-brand transition-colors">Events</a></li>
          <li><a href="/about" class="text-sm text-neutral-400 hover:text-ember-brand transition-colors">About Us</a></li>
          <li><a href="/contact" class="text-sm text-neutral-400 hover:text-ember-brand transition-colors">Contact</a></li>
          <li><a href={homeHref("#mission")} class="text-sm text-neutral-400 hover:text-ember-brand transition-colors">Our Mission</a></li>
          <li><a href={homeHref("#impact")} class="text-sm text-neutral-400 hover:text-ember-brand transition-colors">Our Impact</a></li>
          <li><a href={homeHref("#partners")} class="text-sm text-neutral-400 hover:text-ember-brand transition-colors">Partners</a></li>
          <li><a href={site.primaryDonateUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-400 hover:text-ember-brand transition-colors">Donate</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-display font-bold text-sm uppercase tracking-wider text-neutral-400 mb-4">Contact</h3>
        <ul class="space-y-2.5">
          <li><a href={`mailto:${site.mainEmail}`} class="text-sm text-neutral-400 hover:text-ember-brand transition-colors">{site.mainEmail}</a></li>
          <li><a href="https://ucountcampaign.org" class="text-sm text-neutral-400 hover:text-ember-brand transition-colors">ucountcampaign.org</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 mt-12 pt-8 flex flex-col items-center gap-3 text-center">
      <p class="text-xs text-neutral-500">&copy; {new Date().getFullYear()} {site.siteName}. All rights reserved.</p>
      <p class="text-xs text-neutral-500">{site.siteName} 501(c)3, EIN# {site.ein}, {site.streetAddress}, {site.cityStateZip}</p>
      <p class="text-xs text-neutral-600">{site.tagline}</p>
    </div>
  </div>
</footer>
