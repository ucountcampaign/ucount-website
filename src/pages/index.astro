---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getFeaturedStoreProducts } from "../lib/wix-store";
import {
  cmsImageUrl,
  cmsText,
  cmsValue,
  getImpactAllocations,
  getImpactStats,
  getInitiatives,
  getPageSection,
  getPartners,
  getSiteSettings,
  resolveSiteSettings,
} from "../lib/wix-cms";
import { createWixImageSrcSet, resizeWixImageUrl } from "../lib/images";
import { resolveHeroSocialImage, truncateDescription } from "../lib/seo";
import { setPublicCacheControl } from "../lib/cache";

const [
  siteSettings,
  heroContent,
  missionContent,
  impactContent,
  impactInitiativeHeadingContent,
  impactRegionHeadingContent,
  partnersContent,
  shopContent,
  donateContent,
  heroStatsResult,
  impactStatsResult,
  initiativeAllocationsResult,
  regionAllocationsResult,
  homeInitiativesResult,
  partnersResult,
  storeProductsResult,
] = await Promise.all([
  getSiteSettings(),
  getPageSection("home", "hero"),
  getPageSection("home", "mission-intro"),
  getPageSection("home", "impact-intro"),
  getPageSection("home", "impact-initiative-heading"),
  getPageSection("home", "impact-region-heading"),
  getPageSection("home", "partners-intro"),
  getPageSection("home", "shop-intro"),
  getPageSection("home", "donate-cta"),
  getImpactStats("hero"),
  getImpactStats("impact"),
  getImpactAllocations("initiative"),
  getImpactAllocations("region"),
  getInitiatives("home"),
  getPartners(),
  getFeaturedStoreProducts(6),
]);

const site = resolveSiteSettings(siteSettings);

const hero = {
  eyebrow: cmsText(heroContent?.eyebrow, "Hope, courage, and justice since 2007"),
  title: cmsText(heroContent?.title, "Every person has value. Every person counts."),
  body: cmsText(
    heroContent?.body,
    "With hope, courage, and compassion, we fight trafficking through prevention, awareness, and restoration because every person carries dignity, and justice calls us to persevere.",
  ),
  primaryCtaLabel: cmsText(heroContent?.primaryCtaLabel, "Shop With Purpose"),
  primaryCtaUrl: cmsText(heroContent?.primaryCtaUrl, "#shop"),
  secondaryCtaLabel: cmsText(heroContent?.secondaryCtaLabel, "Donate Now"),
  secondaryCtaUrl: cmsText(
    heroContent?.secondaryCtaUrl,
    "https://www.paypal.com/donate/?hosted_button_id=47BPT2WKXDFCN",
  ),
  image: cmsImageUrl(
    heroContent?.image,
    "https://static.wixstatic.com/media/5117f1_7aad5514ad5f47bd8f100fc9b21c13cb~mv2.jpeg/v1/fit/w_960,h_722,q_82,enc_auto/file.jpg",
  ),
  backgroundImage: cmsImageUrl(
    heroContent?.backgroundImage,
    "https://static.wixstatic.com/media/5117f1_83830d03ce464fa0bd4a61c37c37bb5c~mv2.jpeg/v1/fill/w_480,h_360,al_c,q_82,enc_auto/file.jpg",
  ),
};

const useBrandedHeroTitle =
  hero.title.toLowerCase() ===
  "every person has value. every person counts.".toLowerCase();

const missionIntro = {
  eyebrow: cmsText(missionContent?.eyebrow, "Why We Fight"),
  title: cmsText(missionContent?.title, "Human trafficking is modern-day slavery."),
  subtitle: cmsText(
    missionContent?.subtitle,
    "They are why we fight — with hope, courage, compassion, and grace.",
  ),
  body: cmsText(
    missionContent?.body,
    "When a person is forced, deceived, or coerced into being sold for sex, they become a victim. Nearly 28 million people are trafficked worldwide. Every statistic represents a person with dignity, strength, and the ability to persevere. We respond with compassion, collaborate with trusted partners, and keep our vision fixed on justice.",
  ),
};

const missionTitleMatch = missionIntro.title.match(
  /^(Human trafficking is )(modern-day slavery\.)$/i,
);

const defaultHeroStats = [
  { label: "People enslaved", value: "49.6", suffix: "M", theme: "ember" },
  { label: "Criminal industry", value: "236", suffix: "B", theme: "neutral" },
  { label: "Victims are children", value: "1", suffix: " in 4", theme: "ember" },
];

const defaultImpactStats = [
  {
    label: "Caring support donated",
    value: "175",
    suffix: "K",
    description: "Caring support donated to courageous frontline organizations worldwide.",
    theme: "ember",
  },
  {
    label: "Thoughtful purchases empowering survivors",
    value: "75",
    suffix: "K+",
    description: "Thoughtful purchases empowering survivors with hope and dignity",
    theme: "neutral",
  },
  {
    label: "Motivated volunteers",
    value: "100",
    suffix: "+",
    description: "Motivated volunteers persevering alongside communities",
    theme: "ember",
  },
  {
    label: "Regions reached",
    value: "6",
    suffix: "",
    description: "Regions reached — USA, Europe, Southeast Asia, Latin America, Africa",
    theme: "neutral",
  },
];

const defaultInitiatives = [
  {
    slug: "prevention",
    title: "Prevention",
    shortDescription:
      "Compassionate prevention — intelligence-led intervention before exploitation begins. We persevere to protect the vulnerable with wisdom and vision.",
    accentToken: "ember-brand",
  },
  {
    slug: "awareness",
    title: "Awareness",
    shortDescription:
      "Courageous awareness — opening eyes and mobilizing communities through research, collaboration, and justice-minded action.",
    accentToken: "gold-400",
  },
  {
    slug: "restoration",
    title: "Restoration",
    shortDescription:
      "Grace-filled restoration — safety, community, dignity, and economic opportunity so survivors can persevere and thrive.",
    accentToken: "sky-400",
  },
];

const defaultInitiativeAllocations = [
  { label: "Restoration", percentage: 53, colorToken: "ember-brand" },
  { label: "Prevention", percentage: 32, colorToken: "ember-700" },
  { label: "Awareness", percentage: 15, colorToken: "gold-400" },
];

const defaultRegionAllocations = [
  { label: "USA", percentage: 35, colorToken: "ember-brand" },
  { label: "Global", percentage: 26, colorToken: "neutral-700" },
  { label: "Europe", percentage: 17, colorToken: "neutral-700" },
  { label: "SE Asia", percentage: 15, colorToken: "neutral-700" },
  { label: "Latin America", percentage: 5, colorToken: "neutral-700" },
  { label: "Africa", percentage: 2, colorToken: "neutral-700" },
];

const defaultPartners = [
  {
    slug: "justice-now",
    name: "Justice Now",
    logo: "/assets/partners/justice-now-noco-official.webp",
    tagline: "Education, care kits, and safe transportation for local victims.",
    description:
      "Local organization educating our community, providing care kits to victims, and facilitating safe transportation for those in need.",
    websiteUrl: "https://www.justicenowco.org/",
  },
];

const statNeedsDollar = (label: string) =>
  /donated|purchase|industry/i.test(label);

const formatStatValue = (stat: { label?: string | null; value?: string | number | null; suffix?: string | null }) => {
  const label = cmsText(stat.label, "");
  const suffix = typeof stat.suffix === "string" ? stat.suffix : "";
  return `${statNeedsDollar(label) ? "$" : ""}${cmsValue(stat.value, "")}${suffix}`;
};

const heroStats = (heroStatsResult.length ? heroStatsResult : defaultHeroStats).map(
  (stat) => ({
    label: cmsText(stat.label, ""),
    value: formatStatValue(stat),
    theme: cmsText(stat.theme, "ember"),
  }),
);

const homeInitiatives = (
  homeInitiativesResult.length ? homeInitiativesResult : defaultInitiatives
).map((initiative) => ({
  title: cmsText(initiative.title, ""),
  description: cmsText(initiative.shortDescription, ""),
  accentToken: cmsText(initiative.accentToken, "ember-brand"),
}));

// The stored CMS eyebrow may still read "Our Impact in 2025". Strip the
// trailing year here so the heading reads "Our Impact" without needing the
// collection edited first; the year now lives on the two boxes below.
const storedImpactEyebrow = cmsText(impactContent?.eyebrow, "Our Impact");
const impactIntro = {
  eyebrow: storedImpactEyebrow.replace(/\s+in\s+2025$/i, ""),
  title: cmsText(impactContent?.title, "Courageous impact. Dignity restored."),
};

const impactHeadings = {
  initiative: cmsText(
    impactInitiativeHeadingContent?.title,
    "2025 Spend by Initiative",
  ),
  region: cmsText(impactRegionHeadingContent?.title, "2025 Where We Invest"),
};

const partnersIntro = {
  eyebrow: cmsText(partnersContent?.eyebrow, "Our Partners"),
  title: cmsText(partnersContent?.title, "Courageous partners we stand with."),
  body: cmsText(
    partnersContent?.body,
    "We collaborate with partners whose courage, compassion, and vision we have personally witnessed.",
  ),
};

const shopIntro = {
  eyebrow: cmsText(shopContent?.eyebrow, "Marketplace"),
  title: cmsText(shopContent?.title, "Shop with purpose."),
  body: cmsText(
    shopContent?.body,
    "Every purchase supports women who are at-risk or survivors — strengthening dignity, community, and renewed hope for a brighter future.",
  ),
};

const shopTitleMatch = shopIntro.title.match(/^(Shop with )(purpose\.)$/i);

const impactTitleParts = impactIntro.title.split(". ");
const impactStats = (
  impactStatsResult.length ? impactStatsResult : defaultImpactStats
).map((stat) => ({
  value: formatStatValue(stat),
  description: cmsText(stat.description, cmsText(stat.label, "")),
  theme: cmsText(stat.theme, "ember"),
}));

const initiativeAllocations = (
  initiativeAllocationsResult.length
    ? initiativeAllocationsResult
    : defaultInitiativeAllocations
).map((allocation) => ({
  label: cmsText(allocation.label, ""),
  percentage: cmsValue(allocation.percentage, "0"),
  colorToken: cmsText(allocation.colorToken, "ember-brand"),
}));

const regionAllocations = (
  regionAllocationsResult.length ? regionAllocationsResult : defaultRegionAllocations
).map((allocation) => ({
  label: cmsText(allocation.label, ""),
  percentage: cmsValue(allocation.percentage, "0"),
}));

const colorClass = (token: string) =>
  ({
    "ember-brand": "bg-ember-brand text-ember-brand",
    "ember-700": "bg-ember-700 text-ember-700",
    "gold-400": "bg-gold-400 text-gold-400",
    "sky-400": "bg-sky-400 text-sky-400",
    "neutral-700": "bg-neutral-700 text-neutral-700",
  })[token] ?? "bg-ember-brand text-ember-brand";

const bgColorClass = (token: string) => colorClass(token).split(" ")[0];
const textColorClass = (token: string) => colorClass(token).split(" ")[1];

// Tailwind only emits utilities it can see as complete literals in the source.
// Building these as `${bgColorClass(token)}/20` produced the class name at
// runtime, so only bg-ember-brand/20 (which appears literally elsewhere) was
// ever generated and every other accent rendered with no shading. Spell each
// variant out so all five exist in the compiled stylesheet.
const initiativeAccentClass = (token: string) =>
  ({
    "ember-brand": "bg-ember-brand/20",
    "ember-700": "bg-ember-700/20",
    "gold-400": "bg-gold-400/20",
    "sky-400": "bg-sky-400/20",
    "neutral-700": "bg-neutral-700/20",
  })[token] ?? "bg-ember-brand/20";
const localizeInternalUrl = (url: string) => {
  const value = url.trim();

  if (
    value === "#shop" ||
    /wixstudio\.com\/wix-github-test#shop/i.test(value) ||
    /ucountcampaign\.org\/shop\/?$/i.test(value)
  ) {
    return "/shop";
  }

  if (/ucountcampaign\.org\/contact-us-1\/?$/i.test(value)) {
    return "/contact";
  }

  return value;
};

hero.primaryCtaUrl = localizeInternalUrl(hero.primaryCtaUrl);

// Locally held logos at full resolution. The copies in the CMS are small
// enough to look soft once the spotlight mark is rendered at 8rem, so prefer
// a bundled asset when we have one and fall back to the CMS image otherwise.
const partnerLogoAssets: Record<string, string> = {
  "project-rescue": "/assets/partners/project-rescue.png",
  "stop-the-traffik": "/assets/partners/stop-the-traffik.png",
  "atlas-free": "/assets/partners/atlas-free.png",
  "global-family": "/assets/partners/global-family.png",
  "sarahs-home": "/assets/partners/sarahs-home.png",
  "daniel-academy": "/assets/partners/daniel-academy.png",
  "a-courageous-rose": "/assets/partners/a-courageous-rose.webp",
  "justice-now": "/assets/partners/justice-now-noco-official.webp",
  "restoring-freedom-workshop": "/assets/partners/restoring-freedom-workshop.jpg",
};

const partnerCards = (partnersResult.length ? partnersResult : defaultPartners).map(
  (partner) => {
    const id = cmsText(
      partner.slug,
      cmsText(partner.name, "partner").toLowerCase().replace(/[^a-z0-9]+/g, "-"),
    );

    return {
      id,
      name: cmsText(partner.name, "Partner"),
      logo:
        partnerLogoAssets[id] ??
        cmsImageUrl(partner.logo, "/assets/partners/justice-now-noco-official.webp"),
      tagline: cmsText(partner.tagline, ""),
      description: cmsText(partner.description, ""),
      url: cmsText(partner.websiteUrl, "#"),
    };
  },
);

const partnersJson = JSON.stringify(partnerCards).replace(/</g, "\\u003c");
const storeProducts = storeProductsResult.products;
const heroImage = resizeWixImageUrl(hero.image, {
  width: 960,
  height: 722,
  mode: "fit",
});
const heroShareImage = resolveHeroSocialImage(heroContent);
const heroImageSrcSet = createWixImageSrcSet(
  hero.image,
  [
    { width: 640, height: 482 },
    { width: 800, height: 602 },
    { width: 960, height: 722 },
  ],
  "fit",
);
const heroBackgroundImage = resizeWixImageUrl(hero.backgroundImage, {
  width: 480,
  height: 360,
  mode: "fill",
});
const heroBackgroundImageSrcSet = createWixImageSrcSet(
  hero.backgroundImage,
  [
    { width: 240, height: 180 },
    { width: 360, height: 270 },
    { width: 480, height: 360 },
  ],
  "fill",
);
const homeDescription = truncateDescription(
  "U COUNT fights human trafficking with hope, courage, and justice through prevention, awareness, restoration, partners, and a shop-with-purpose marketplace.",
);

setPublicCacheControl(Astro.response.headers);

const donateCta = {
  title: cmsText(
    donateContent?.title,
    "Join us with hope and courage. Be part of the change.",
  ),
  body: cmsText(
    donateContent?.body,
    "Whether you donate, shop, volunteer, or pray, every act of compassion strengthens community, advances justice, and helps survivors persevere toward freedom.",
  ),
  primaryCtaLabel: cmsText(donateContent?.primaryCtaLabel, "Donate Now"),
  primaryCtaUrl: cmsText(
    donateContent?.primaryCtaUrl,
    "https://www.paypal.com/donate/?hosted_button_id=47BPT2WKXDFCN",
  ),
  secondaryCtaLabel: cmsText(donateContent?.secondaryCtaLabel, "Shop the Marketplace"),
  secondaryCtaUrl: localizeInternalUrl(cmsText(donateContent?.secondaryCtaUrl, "/shop")),
};
---
<BaseLayout
  title="U COUNT — Hope, Courage & Justice Against Human Trafficking"
  site={site}
  activePage="home"
  meta={{
    description: homeDescription,
    canonicalPath: "/",
    image: heroShareImage,
    imageAlt: "U COUNT anti-trafficking work through prevention, awareness, and restoration",
    keywords: [
      "U COUNT",
      "human trafficking prevention",
      "anti-trafficking nonprofit",
      "Fort Collins nonprofit",
      "survivor restoration",
      "ethical marketplace",
      "shop with purpose",
      "anti-trafficking partners",
      "hope courage justice",
    ],
  }}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/partners.css" />
    <style is:global>
    .fingerprint-mark {
      filter: sepia(0) saturate(0) brightness(0.82);
    }

    @keyframes scroll-bob {
      0%, 100% { transform: translateY(0); opacity: 0.7; }
      50% { transform: translateY(6px); opacity: 1; }
    }
    .scroll-hint {
      animation: scroll-bob 2s ease-in-out infinite;
    }

    .grain::after {
      content: '';
      position: absolute;
      inset: 0;
      opacity: 0.03;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 1;
    }

    @keyframes ember-glow {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
    .ember-gradient {
      background: linear-gradient(135deg, #572508 0%, #8C3D10 25%, #F38720 50%, #E67635 75%, #572508 100%);
      background-size: 300% 300%;
      animation: ember-glow 8s ease-in-out infinite;
    }

    @keyframes count-up {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .stat-reveal {
      animation: count-up 0.6s ease-out both;
    }
    .stat-reveal:nth-child(2) { animation-delay: 0.15s; }
    .stat-reveal:nth-child(3) { animation-delay: 0.3s; }
    .stat-reveal:nth-child(4) { animation-delay: 0.45s; }

    .product-card {
      overflow: hidden;
      border: 1px solid rgba(207, 207, 207, 0.72);
      border-radius: 1.25rem;
      background: white;
      box-shadow: 0 14px 32px rgba(34, 34, 34, 0.06);
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
    }
    .product-card > div:first-child {
      margin-bottom: 0;
      border-radius: 0;
    }
    .product-card > div:last-child {
      min-height: 5.75rem;
      padding: 1rem 1.1rem 1.1rem;
      background: white;
    }
    .product-card img {
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .product-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 40px -12px rgba(87, 37, 8, 0.15);
    }
    .product-card:hover img {
      transform: scale(1.035);
    }

    @keyframes marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    .marquee-track {
      animation: marquee 30s linear infinite;
    }
    .marquee-track:hover {
      animation-play-state: paused;
    }

    .diagonal-top {
      clip-path: polygon(0 8%, 100% 0, 100% 100%, 0 100%);
    }
    @media (max-width: 768px) {
      .diagonal-top {
        clip-path: polygon(0 3%, 100% 0, 100% 100%, 0 100%);
      }
    }

    .donut {
      width: 180px;
      height: 180px;
      border-radius: 50%;
      background: conic-gradient(
        #F38720 0% 53%,
        #8C3D10 53% 85%,
        #F7D070 85% 100%
      );
      position: relative;
      flex-shrink: 0;
    }
    .donut::after {
      content: '';
      position: absolute;
      inset: 22%;
      border-radius: 50%;
      background: white;
    }

    .partner-switch {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
      margin: 2rem auto 2.5rem;
      max-width: 70rem;
    }

    .partner-switch-btn {
      appearance: none;
      border: 1px solid #d6d3d1;
      background: rgba(255, 255, 255, 0.85);
      color: #626262;
      border-radius: 999px;
      padding: 0.8rem 1rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1;
      transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
      backdrop-filter: blur(16px);
      box-shadow: 0 10px 24px rgba(34, 34, 34, 0.05);
    }

    .partner-switch-btn:hover,
    .partner-switch-btn:focus-visible {
      border-color: #F38720;
      color: #8C3D10;
      transform: translateY(-1px);
      outline: none;
    }

    .partner-switch-btn.is-active {
      background: #222222;
      color: white;
      border-color: #222222;
      box-shadow: 0 16px 32px rgba(34, 34, 34, 0.18);
    }

    .partner-stage {
      --partner-spotlight-min-height: 20rem;
      position: relative;
      min-height: 0;
      overflow-anchor: none;
    }

    .partner-accordion-grid {
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 1rem;
      align-items: start;
    }

    .partner-directory-button,
    .partner-feature-card,
    .partner-bento-card,
    .partner-moving-card,
    .partner-spotlight-panel {
      border: 1px solid #d6d3d1;
      background: rgba(255, 255, 255, 0.92);
      box-shadow: 0 12px 28px rgba(34, 34, 34, 0.06);
    }

    /* Stack: watermark layer is behind <details> (page bg → wm → white chrome) */
    .partner-accordion-stack {
      --partner-accordion-header-height: 6.1rem;
      --partner-accordion-watermark-height: 9.5rem;
      position: relative;
      width: 100%;
      align-self: start;
      border-radius: 1.5rem;
      overflow: hidden;
    }

    /* Reserve space below header only while watermark is shown (paired-column reveal) */
    .partner-accordion-stack:has(.partner-accordion-wm--visible) {
      min-height: calc(var(--partner-accordion-header-height) + var(--partner-accordion-watermark-height));
    }

    .partner-accordion-wm {
      position: absolute;
      left: 0;
      right: 0;
      top: var(--partner-accordion-header-height);
      min-height: var(--partner-accordion-watermark-height);
      z-index: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      padding: 1rem;
      box-sizing: border-box;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.5s ease, visibility 0s linear 0.5s;
    }

    .partner-accordion-wm--visible {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.5s ease, visibility 0s linear 0s;
    }

    .partner-accordion-wm-img {
      width: min(78%, 10.5rem);
      height: auto;
      max-height: calc(var(--partner-accordion-watermark-height) - 2rem);
      object-fit: contain;
      opacity: 0.16;
    }

    .partner-accordion-card {
      position: relative;
      z-index: 1;
      margin: 0;
      border: none;
      background: transparent;
      box-shadow: none;
    }

    .partner-accordion-summary {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.25rem;
      cursor: pointer;
      background: #fff;
      border: 1px solid #d6d3d1;
      border-radius: 1.5rem 1.5rem 0 0;
      box-shadow: 0 12px 28px rgba(34, 34, 34, 0.06);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .partner-accordion-card:not([open]) .partner-accordion-summary {
      border-radius: 1.5rem;
    }

    .partner-accordion-card[open] .partner-accordion-summary {
      border-bottom: none;
      border-radius: 1.5rem 1.5rem 0 0;
      box-shadow: none;
    }

    .partner-accordion-stack:hover .partner-accordion-summary {
      border-color: #f2b179;
    }

    .partner-accordion-stack:hover .partner-accordion-card[open] .partner-body {
      border-color: #f2b179;
    }

    .partner-accordion-stack:hover .partner-accordion-summary {
      box-shadow: 0 18px 36px rgba(34, 34, 34, 0.08);
    }

    .partner-head {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      min-width: 0;
    }

    .partner-title {
