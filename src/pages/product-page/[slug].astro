---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSiteSettings, resolveSiteSettings } from "../../lib/wix-cms";
import { getStoreProductBySlug } from "../../lib/wix-store";

const slug = Astro.params.slug ?? "";
const [siteSettings, product] = await Promise.all([
  getSiteSettings(),
  getStoreProductBySlug(slug),
]);

const site = resolveSiteSettings(siteSettings);
const checkoutStatus = Astro.url.searchParams.get("checkout");

if (!product) {
  Astro.response.status = 404;
}

const images = product?.images.length
  ? product.images
  : product
    ? [{
        id: product.id,
        url: product.image,
        thumbnailUrl: product.image,
        fullUrl: product.image,
        srcSet: product.imageSrcSet,
        alt: product.imageAlt,
      }]
    : [];
const availableVariants = product?.variants.filter(
  (variant) => variant.visible && variant.inStock,
) ?? [];
const visibleVariants = product?.variants.filter((variant) => variant.visible) ?? [];
const canCheckout =
  Boolean(product?.inStock) &&
  (!product?.manageVariants || availableVariants.length > 0);
const variantJson = JSON.stringify(product?.variants ?? []).replace(/</g, "\\u003c");
const nonVariantMax = product && !product.manageVariants ? product.stockQuantity : null;
const imagesForPage = images.map((image, index) => {
  const relatedVariants = visibleVariants.filter(
    (variant) =>
      variant.image &&
      (variant.image.fullUrl === image.fullUrl ||
        variant.image.url === image.url ||
        variant.image.thumbnailUrl === image.thumbnailUrl),
  );
  const fallbackVariant =
    relatedVariants.length === 0 && visibleVariants.length === images.length
      ? visibleVariants[index]
      : undefined;
  const imageVariants = relatedVariants.length ? relatedVariants : fallbackVariant ? [fallbackVariant] : [];
  const availableVariant = imageVariants.find((variant) => variant.inStock);
  const primaryVariant = availableVariant ?? imageVariants[0];
  const isUnavailable = imageVariants.length > 0 && !availableVariant;

  return {
    ...image,
    variantId: primaryVariant?.id ?? "",
    variantLabel: primaryVariant?.label ?? "",
    variantInStock: imageVariants.length === 0 || Boolean(availableVariant),
    availabilityLabel: isUnavailable ? "Out of stock" : "",
  };
});
const initialImageVariant = imagesForPage.find(
  (image) =>
    image.variantId &&
    image.variantInStock &&
    availableVariants.some((variant) => variant.id === image.variantId),
);
const initialVariant = product?.manageVariants
  ? availableVariants.find((variant) => variant.id === initialImageVariant?.variantId) ??
    availableVariants[0]
  : undefined;
const activeImageIndexCandidate = initialVariant
  ? imagesForPage.findIndex(
      (image) =>
        image.variantId === initialVariant.id ||
        (initialVariant.image &&
          (image.fullUrl === initialVariant.image.fullUrl ||
            image.url === initialVariant.image.url ||
            image.thumbnailUrl === initialVariant.image.thumbnailUrl)),
    )
  : 0;
const activeImageIndex = activeImageIndexCandidate >= 0 ? activeImageIndexCandidate : 0;
const primaryImage =
  imagesForPage[activeImageIndex] ?? initialVariant?.image ?? images[0];

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=300, stale-while-revalidate=3600",
);
---

<BaseLayout title={product ? `${product.name} — U COUNT Marketplace` : "Product Not Found — U COUNT"} site={site} activePage="shop">
  {product ? (
    <>
      <section class="bg-neutral-50 pt-28 pb-8 lg:pt-32">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
          <a href="/shop" class="inline-flex items-center gap-2 text-sm font-semibold text-neutral-500 transition-colors hover:text-ember-brand">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg>
            Marketplace
          </a>
        </div>
      </section>

      <section class="pt-8 pb-16 lg:pt-12 lg:pb-24">
        <div class="max-w-7xl mx-auto grid gap-12 px-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(24rem,0.95fr)] lg:px-8">
          <div>
            <div class="aspect-square overflow-hidden rounded-2xl bg-neutral-100">
              {primaryImage && (
                <a id="productMainImageLink" href={primaryImage.fullUrl} target="_blank" rel="noopener noreferrer" class="block h-full w-full" aria-label={`Open larger image of ${product.name}`}>
                  <img
                    id="productMainImage"
                    src={primaryImage.url}
                    srcset={primaryImage.srcSet}
                    sizes="(min-width: 1024px) 52vw, 100vw"
                    alt={primaryImage.alt}
                    class="h-full w-full object-contain transition-opacity duration-300 ease-out"
                    fetchpriority="high"
                    decoding="async"
                  />
                </a>
              )}
            </div>

            {images.length > 1 && (
              <div class="mt-4 grid grid-cols-5 gap-3 sm:grid-cols-6">
                {imagesForPage.map((image, index) => (
                  <button
                    type="button"
                    class={`relative aspect-square overflow-hidden rounded-xl border bg-neutral-100 transition-colors hover:border-ember-brand ${index === activeImageIndex ? "border-ember-brand ring-2 ring-ember-brand/20" : "border-neutral-200"} ${image.availabilityLabel ? "text-neutral-900" : ""}`}
                    data-image-button
                    data-image-url={image.url}
                    data-image-srcset={image.srcSet}
                    data-image-full-url={image.fullUrl}
                    data-image-alt={image.alt}
                    data-image-variant-id={image.variantId}
                    data-image-variant-label={image.variantLabel}
                    data-image-variant-in-stock={image.variantInStock ? "true" : "false"}
                    aria-pressed={index === activeImageIndex ? "true" : "false"}
                    aria-label={`View image ${index + 1}${image.variantLabel ? `, ${image.variantLabel}` : ""}${image.availabilityLabel ? `, ${image.availabilityLabel}` : ""}`}
                  >
                    <img src={image.thumbnailUrl} alt="" class={`h-full w-full object-cover ${image.availabilityLabel ? "opacity-45 grayscale-[25%]" : ""}`} loading="lazy" />
                    {image.availabilityLabel && (
                      <>
                        <span class="absolute inset-0 bg-white/20" aria-hidden="true"></span>
                        <span class="absolute inset-x-1 bottom-1 rounded-md bg-neutral-900/90 px-1.5 py-1 text-[10px] font-bold uppercase leading-none tracking-[0.04em] text-white">
                          <span class="hidden sm:inline">Out of stock</span>
                          <span class="sm:hidden">Out</span>
                        </span>
                      </>
                    )}
                  </button>
                ))}
              </div>
            )}
            <p class="mt-3 text-sm font-semibold text-neutral-500" data-image-status aria-live="polite" hidden></p>
          </div>

          <div class="lg:pt-4">
            {product.ribbon && (
              <span class="mb-4 inline-flex bg-ember-brand px-4 py-1.5 text-xs font-bold text-white shadow-sm shadow-ember-brand/20">
                {product.ribbon}
              </span>
            )}
            {product.categoryNames.length > 0 && (
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-ember-600">{product.categoryNames.join(" / ")}</p>
            )}
            <h1 class="font-display text-4xl font-bold tracking-tight text-neutral-900 lg:text-5xl">{product.name}</h1>
            {product.price && (
              <p class="mt-4 font-display text-2xl font-bold text-ember-brand">{product.price}</p>
            )}

            {!product.inStock && (
              <div class="mt-6 rounded-2xl border border-neutral-200 bg-neutral-50 px-5 py-4 text-sm font-semibold text-neutral-600">
                This product is currently out of stock.
              </div>
            )}

            {checkoutStatus === "error" && (
              <div class="mt-6 rounded-2xl border border-danger-200 bg-danger-50 px-5 py-4 text-sm font-semibold text-danger-500">
                Checkout could not be started. Please try again or contact U COUNT for help.
              </div>
            )}

            {product.fullDescription && (
              <p class="mt-6 text-base leading-relaxed text-neutral-600">{product.fullDescription}</p>
            )}

            <form action="/api/checkout" method="POST" class="mt-8 space-y-6 rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm" data-checkout-form>
              <input type="hidden" name="productId" value={product.id} />
              <input type="hidden" name="productSlug" value={product.slug} />

              {product.manageVariants && (
                <div>
                  <label id="variantLabel" class="mb-2 block text-sm font-semibold text-neutral-700">Options</label>
                  <div class="relative" data-custom-select data-required-select>
                    <input id="variantId" type="hidden" name="variantId" value={initialVariant?.id ?? ""} data-custom-select-input data-variant-input />
                    <button
                      type="button"
                      class="ui-select-trigger h-12 rounded-xl"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-labelledby="variantLabel variantValue"
                      disabled={!availableVariants.length}
                      data-custom-select-trigger
                    >
                      <span id="variantValue" data-custom-select-value>{initialVariant?.label ?? "Unavailable"}</span>
                      <svg class="h-4 w-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="ui-select-menu" role="listbox" aria-labelledby="variantLabel" hidden data-custom-select-menu>
                      {product.variants.filter((variant) => variant.visible).map((variant) => (
                        <button
                          type="button"
                          role="option"
                          class="ui-select-option"
                          data-custom-select-option
                          data-value={variant.id}
                          data-label={variant.label}
                          data-option-in-stock={variant.inStock ? "true" : "false"}
                          aria-selected={variant.id === initialVariant?.id ? "true" : "false"}
                        >
                          {variant.label}{variant.inStock ? "" : " - Out of stock"}
                        </button>
                      ))}
                    </div>
                  </div>
                  <p id="variantError" class="mt-2 text-sm font-semibold text-danger-500" hidden data-variant-error>
                    Select an available option before checkout.
                  </p>
                </div>
              )}

              <div>
                <label for="quantity" class="mb-2 block text-sm font-semibold text-neutral-700">Quantity</label>
                <div class="inline-flex h-12 overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-sm focus-within:border-ember-brand focus-within:ring-2 focus-within:ring-ember-brand/20">
                  <button type="button" class="w-11 border-r border-neutral-200 text-lg font-semibold text-neutral-600 transition-colors hover:bg-neutral-50 disabled:cursor-not-allowed disabled:text-neutral-300" disabled={!canCheckout} aria-label="Decrease quantity" data-quantity-decrement>-</button>
                  <input
                    id="quantity"
                    name="quantity"
                    type="number"
                    min="1"
                    max="100"
                    value="1"
                    required
                    disabled={!canCheckout}
                    class="h-full w-16 border-0 bg-white px-3 text-center text-sm font-semibold text-neutral-900 focus:outline-none disabled:bg-neutral-100 disabled:text-neutral-400"
                    data-quantity-input
                  />
                  <button type="button" class="w-11 border-l border-neutral-200 text-lg font-semibold text-neutral-600 transition-colors hover:bg-neutral-50 disabled:cursor-not-allowed disabled:text-neutral-300" disabled={!canCheckout} aria-label="Increase quantity" data-quantity-increment>+</button>
                </div>
                <p class="mt-2 text-xs font-semibold text-ember-600" data-stock-hint aria-live="polite" hidden></p>
              </div>

              <div class="space-y-3">
                <button
                  type="button"
                  disabled={!canCheckout}
                  data-add-to-cart
                  data-checkout-base-enabled={canCheckout ? "true" : "false"}
                  data-product-id={product.id}
                  data-product-slug={product.slug}
                  data-product-name={product.name}
                  data-product-url={product.url}
                  data-product-image={primaryImage?.url ?? product.image}
                  data-product-price={product.price}
                  data-product-price-value={product.priceValue ?? ""}
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-ember-brand px-6 py-3.5 font-display text-sm font-semibold text-white shadow-lg shadow-ember-brand/25 transition-colors hover:bg-ember-500 disabled:cursor-not-allowed disabled:bg-neutral-300 disabled:shadow-none"
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293A1 1 0 005.414 17H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                  Add to Cart
                </button>
                <button
                  type="submit"
                  disabled={!canCheckout}
                  data-checkout-submit
                  data-checkout-base-enabled={canCheckout ? "true" : "false"}
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-ember-brand bg-white px-6 py-3.5 font-display text-sm font-semibold text-ember-brand transition-colors hover:bg-ember-50 disabled:cursor-not-allowed disabled:border-neutral-200 disabled:bg-white disabled:text-neutral-300"
                >
                  Buy Now
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </button>
              </div>
            </form>

            {product.additionalInfoSections.length > 0 && (
              <div class="mt-8 divide-y divide-neutral-200 border-y border-neutral-200">
                {product.additionalInfoSections.map((section) => (
                  <div class="py-5">
                    <h2 class="font-display text-base font-bold text-neutral-900">{section.title}</h2>
                    {section.body && (
                      <p class="mt-1 text-sm leading-relaxed text-neutral-600">{section.body}</p>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>

      <script define:vars={{ variantJson, nonVariantMax }}>
        const variants = JSON.parse(variantJson);
        const mainImage = document.getElementById("productMainImage");
        const mainImageLink = document.getElementById("productMainImageLink");
        const variantInput = document.getElementById("variantId");
        const variantError = document.querySelector("[data-variant-error]");
        const checkoutForm = document.querySelector("[data-checkout-form]");
        const imageButtons = document.querySelectorAll("[data-image-button]");
        const imageStatus = document.querySelector("[data-image-status]");
        const quantityInput = document.querySelector("[data-quantity-input]");
        const quantityDecrement = document.querySelector("[data-quantity-decrement]");
        const quantityIncrement = document.querySelector("[data-quantity-increment]");
        const checkoutButton = document.querySelector("[data-checkout-submit]");
        const addToCartButton = document.querySelector("[data-add-to-cart]");
        const requiredSelect = document.querySelector("[data-required-select]");
        const variantTrigger = requiredSelect?.querySelector("[data-custom-select-trigger]");
        const variantValueLabel = requiredSelect?.querySelector("[data-custom-select-value]");
        const variantOptions = Array.from(requiredSelect?.querySelectorAll("[data-custom-select-option]") ?? []);
        let mainImageSwapToken = 0;

        function initCustomSelects() {
          document.querySelectorAll("[data-custom-select]").forEach((select) => {
            const trigger = select.querySelector("[data-custom-select-trigger]");
            const menu = select.querySelector("[data-custom-select-menu]");
            const input = select.querySelector("[data-custom-select-input]");
            const valueLabel = select.querySelector("[data-custom-select-value]");
            const options = Array.from(select.querySelectorAll("[data-custom-select-option]"));

            if (!trigger || !menu || !input || !valueLabel) {
              return;
            }

            function closeMenu() {
              menu.hidden = true;
              trigger.setAttribute("aria-expanded", "false");
            }

            function openMenu() {
              menu.hidden = false;
              trigger.setAttribute("aria-expanded", "true");
            }

            trigger.addEventListener("click", () => {
              if (menu.hidden) {
                openMenu();
              } else {
                closeMenu();
              }
            });

            options.forEach((option) => {
              option.addEventListener("click", () => {
                const variantId = option.dataset.value ?? "";
                const variant = variants.find((item) => item.id === variantId);

                if (variant && select.hasAttribute("data-required-select")) {
                  const inStock = option.dataset.optionInStock !== "false";

                  setVariantSelection({
                    variantId,
                    label: option.dataset.label || variant.label,
                    inStock,
                  });

                  if (variant.image?.url) {
                    setMainImage({
                      url: variant.image.url,
                      srcset: variant.image.srcSet,
                      fullUrl: variant.image.fullUrl ?? variant.image.url,
                      alt: variant.image.alt,
                    });
                  }

                  const matchingButton = findImageButtonForVariant(variant);

                  if (matchingButton) {
                    setActiveImageButton(matchingButton);
                  }

                  setImageStatus(
                    inStock ? "" : `${option.dataset.label || variant.label || "This option"} is out of stock.`,
                  );
                  closeMenu();
                  return;
                }

                input.value = option.dataset.value ?? "";
                valueLabel.textContent = option.textContent?.trim() ?? "";
                trigger.removeAttribute("aria-invalid");
                options.forEach((item) => {
                  item.setAttribute("aria-selected", String(item === option));
                });
                closeMenu();
                input.dispatchEvent(new Event("change", { bubbles: true }));
              });
            });

            document.addEventListener("click", (event) => {
              if (!event.target || !select.contains(event.target)) {
                closeMenu();
              }
            });

            select.addEventListener("keydown", (event) => {
              if (event.key === "Escape") {
                closeMenu();
                trigger.focus();
              }
            });
          });
        }

        function setMainImage({ url, srcset, fullUrl, alt }) {
          if (!mainImage || !url) {
            return;
          }

          if (mainImageLink && fullUrl) {
            mainImageLink.href = fullUrl;
          }

          if (mainImage.currentSrc === url || mainImage.src === url) {
            if (alt) {
              mainImage.alt = alt;
            }
            return;
          }

          const token = (mainImageSwapToken += 1);

          const applySwap = () => {
            if (token !== mainImageSwapToken) {
              return;
            }

            mainImage.style.transition = "none";
            mainImage.style.opacity = "0";
            void mainImage.offsetWidth;

            mainImage.src = url;

            if (srcset) {
              mainImage.srcset = srcset;
            } else {
              mainImage.removeAttribute("srcset");
            }

            if (alt) {
              mainImage.alt = alt;
            }

            requestAnimationFrame(() => {
              if (token !== mainImageSwapToken) {
                return;
              }
              mainImage.style.transition = "";
              mainImage.style.opacity = "";
            });
          };

          const preloader = new Image();
          preloader.sizes = mainImage.sizes || "(min-width: 1024px) 52vw, 100vw";

          if (srcset) {
            preloader.srcset = srcset;
          }

          preloader.src = url;

          if (typeof preloader.decode === "function") {
            preloader.decode().then(applySwap).catch(applySwap);
          } else if (preloader.complete) {
            applySwap();
          } else {
            preloader.onload = applySwap;
            preloader.onerror = applySwap;
          }
        }

        function setActiveImageButton(activeButton) {
          imageButtons.forEach((item) => {
            const isSelected = item === activeButton;
            item.setAttribute("aria-pressed", String(isSelected));
            item.classList.toggle("border-ember-brand", isSelected);
            item.classList.toggle("ring-2", isSelected);
            item.classList.toggle("ring-ember-brand/20", isSelected);
            item.classList.toggle("border-neutral-200", !isSelected);
          });
        }

        function findImageButtonForVariant(variant) {
          const variantButton = Array.from(imageButtons).find(
            (button) => button.dataset.imageVariantId === variant?.id,
          );

          if (variantButton) {
            return variantButton;
          }

          if (!variant?.image) {
            return null;
          }

          return Array.from(imageButtons).find((button) => {
            return (
              button.dataset.imageFullUrl === variant.image.fullUrl ||
              button.dataset.imageUrl === variant.image.url ||
              button.dataset.imageUrl === variant.image.fullUrl
            );
          }) ?? null;
        }

        function setVariantSelection({ variantId, label, inStock }) {
          if (!variantInput || !variantValueLabel) {
            return;
          }

          const option = variantOptions.find((item) => item.dataset.value === variantId);
          const displayLabel =
            label ||
            option?.dataset.label ||
            option?.textContent?.trim().replace(/\s+-\s+Out of stock$/, "") ||
            "Unavailable";

          variantValueLabel.textContent = inStock ? displayLabel : `${displayLabel} - Out of stock`;
          variantOptions.forEach((item) => {
            item.setAttribute("aria-selected", String(item === option));
          });
          setCheckoutAvailability(Boolean(inStock && variantId));

          if (inStock && variantId) {
            variantInput.value = variantId;
            variantTrigger?.removeAttribute("aria-invalid");
            if (variantError) {
              variantError.hidden = true;
            }
            return;
          }

          variantInput.value = "";
        }

        function setCheckoutAvailability(isSelectedVariantAvailable) {
          const baseEnabled = checkoutButton?.dataset.checkoutBaseEnabled === "true";
          const enabled = Boolean(baseEnabled && isSelectedVariantAvailable);

          if (checkoutButton) {
            checkoutButton.disabled = !enabled;
          }

          if (addToCartButton) {
            addToCartButton.disabled = !enabled;
          }

          [quantityInput, quantityDecrement, quantityIncrement].forEach((control) => {
            if (control) {
              control.disabled = !enabled;
            }
          });

          if (quantityIncrement) {
            quantityIncrement.dataset.lockedOut = String(!enabled);
          }

          if (enabled) {
            applyQuantityLimit();
          }
        }

        function parsePriceValue(formatted, fallback) {
          const numeric = Number.parseFloat(String(formatted ?? "").replace(/[^0-9.]/g, ""));
          return Number.isFinite(numeric) ? numeric : fallback;
        }

        function parseCurrencySymbol(formatted) {
          const match = String(formatted ?? "").match(/^[^\d]+/);
          return match ? match[0].trim() : "$";
        }

        function addCurrentSelectionToCart() {
          if (!addToCartButton || addToCartButton.disabled) {
            return;
          }

          if (variantInput && !variantInput.value) {
            variantError?.removeAttribute("hidden");
            variantTrigger?.setAttribute("aria-invalid", "true");
            variantTrigger?.focus();
            return;
          }

          const variantId = variantInput?.value || "";
          const variant = variants.find((item) => item.id === variantId);
          const priceFormatted = variant?.price || addToCartButton.dataset.productPrice || "";
          const baseValue = Number.parseFloat(addToCartButton.dataset.productPriceValue || "");
          const limit = getCurrentMaxQuantity();
          let quantity = Number.parseInt(quantityInput?.value || "1", 10);
          quantity = Number.isFinite(quantity) ? Math.max(1, quantity) : 1;

          if (typeof limit === "number") {
            quantity = Math.min(quantity, Math.max(1, limit));
          }

          window.dispatchEvent(
            new CustomEvent("cart:add", {
              detail: {
                productId: addToCartButton.dataset.productId,
                productSlug: addToCartButton.dataset.productSlug,
                variantId,
                name: addToCartButton.dataset.productName,
                variantLabel: variant?.label || "",
                price: priceFormatted,
                priceValue: parsePriceValue(
                  priceFormatted,
                  Number.isFinite(baseValue) ? baseValue : 0,
                ),
                currency: parseCurrencySymbol(priceFormatted),
                image: variant?.image?.url || addToCartButton.dataset.productImage || "",
                url: addToCartButton.dataset.productUrl || "",
                quantity,
                maxQuantity: typeof limit === "number" ? limit : null,
              },
            }),
          );
        }

        addToCartButton?.addEventListener("click", addCurrentSelectionToCart);

        function setImageStatus(message) {
          if (!imageStatus) {
            return;
          }

          imageStatus.hidden = !message;
          imageStatus.textContent = message;
        }

        function preloadGalleryImages() {
          const load = () => {
            imageButtons.forEach((button, index) => {
              if (index === 0 || !button.dataset.imageUrl) {
                return;
              }

              const image = new Image();
              image.sizes = mainImage?.sizes || "(min-width: 1024px) 52vw, 100vw";

              if (button.dataset.imageSrcset) {
                image.srcset = button.dataset.imageSrcset;
              }

              image.src = button.dataset.imageUrl;
            });
          };

          if ("requestIdleCallback" in window) {
            window.requestIdleCallback(load, { timeout: 1500 });
          } else {
            window.setTimeout(load, 300);
          }
        }

        imageButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const variantId = button.dataset.imageVariantId || "";
            const variantLabel = button.dataset.imageVariantLabel || "";
            const variantInStock = button.dataset.imageVariantInStock === "true";

            setActiveImageButton(button);
            setMainImage({
              url: button.dataset.imageUrl,
              srcset: button.dataset.imageSrcset,
              fullUrl: button.dataset.imageFullUrl,
              alt: button.dataset.imageAlt || mainImage?.alt,
            });

            if (variantId) {
              setVariantSelection({
                variantId,
                label: variantLabel,
                inStock: variantInStock,
              });
            }

            setImageStatus(
              variantId && !variantInStock
                ? `${variantLabel || "This option"} is out of stock.`
                : "",
            );
          });
        });

        variantInput?.addEventListener("change", () => {
          const variant = variants.find((item) => item.id === variantInput.value);

          if (variantError) {
            variantError.hidden = true;
          }

          if (!variant?.image?.url) {
            return;
          }

          setMainImage({
            url: variant.image.url,
            srcset: variant.image.srcSet,
            fullUrl: variant.image.fullUrl ?? variant.image.url,
            alt: variant.image.alt,
          });

          const matchingButton = findImageButtonForVariant(variant);

          if (matchingButton) {
            setActiveImageButton(matchingButton);
          }

          setImageStatus("");
          applyQuantityLimit();
        });

        const stockHint = document.querySelector("[data-stock-hint]");

        function getCurrentMaxQuantity() {
          if (variantInput && variantInput.value) {
            const variant = variants.find((item) => item.id === variantInput.value);
            return variant && typeof variant.quantity === "number" ? variant.quantity : null;
          }

          return typeof nonVariantMax === "number" ? nonVariantMax : null;
        }

        function setQuantity(value) {
          if (!quantityInput) {
            return;
          }

          const min = Number.parseInt(quantityInput.min || "1", 10);
          const limit = getCurrentMaxQuantity();
          const max = typeof limit === "number" ? Math.max(1, limit) : 100;
          const nextValue = Math.min(max, Math.max(min, value));
          quantityInput.value = String(nextValue);
          applyQuantityLimit();
        }

        function applyQuantityLimit() {
          if (!quantityInput) {
            return;
          }

          const limit = getCurrentMaxQuantity();
          const current = Number.parseInt(quantityInput.value || "1", 10) || 1;

          if (typeof limit === "number") {
            quantityInput.max = String(Math.max(1, limit));

            if (current > limit) {
              quantityInput.value = String(Math.max(1, limit));
            }

            if (quantityIncrement) {
              quantityIncrement.disabled =
                quantityIncrement.dataset.lockedOut === "true" ||
                Number.parseInt(quantityInput.value || "1", 10) >= limit;
            }

            if (stockHint) {
              if (limit <= 10) {
                stockHint.textContent =
                  limit === 1 ? "Only 1 left in stock" : `Only ${limit} left in stock`;
                stockHint.hidden = false;
              } else {
                stockHint.hidden = true;
              }
            }
          } else {
            quantityInput.max = "100";
            if (quantityIncrement) {
              quantityIncrement.disabled = quantityIncrement.dataset.lockedOut === "true";
            }
            if (stockHint) {
              stockHint.hidden = true;
            }
          }
        }

        quantityDecrement?.addEventListener("click", () => {
          setQuantity(Number.parseInt(quantityInput?.value || "1", 10) - 1);
        });

        quantityIncrement?.addEventListener("click", () => {
          setQuantity(Number.parseInt(quantityInput?.value || "1", 10) + 1);
        });

        checkoutForm?.addEventListener("submit", (event) => {
          if (variantInput && !variantInput.value) {
            event.preventDefault();
            variantError?.removeAttribute("hidden");
            variantTrigger?.setAttribute("aria-invalid", "true");
            variantTrigger?.focus();
          }
        });

        initCustomSelects();
        preloadGalleryImages();
        applyQuantityLimit();
      </script>
    </>
  ) : (
    <section class="min-h-[60vh] bg-neutral-50 pt-32 pb-20">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h1 class="font-display text-4xl font-bold text-neutral-900">Product not found</h1>
        <p class="mt-4 text-neutral-600">The marketplace item you requested is no longer available.</p>
        <a href="/shop" class="mt-8 inline-flex items-center justify-center rounded-full bg-ember-brand px-6 py-3 font-display text-sm font-semibold text-white">
          Back to Marketplace
        </a>
      </div>
    </section>
  )}
</BaseLayout>
