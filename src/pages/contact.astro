---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  cmsText,
  getPageSection,
  getSiteSettings,
  resolveSiteSettings,
} from "../lib/wix-cms";
import { isWixContactFormConfigured } from "../lib/wix-contact";
import {
  breadcrumbSchema,
  getSiteUrl,
  resolveSocialImageMeta,
  truncateDescription,
} from "../lib/seo";
import SocialLinks from "../components/SocialLinks.astro";

const [siteSettings, heroContent] = await Promise.all([
  getSiteSettings(),
  getPageSection("contact", "hero"),
]);

const site = resolveSiteSettings(siteSettings);
const siteUrl = getSiteUrl(Astro.url.origin);

const hero = {
  title: cmsText(heroContent?.title, "Get In Touch"),
  body: cmsText(
    heroContent?.body,
    "We'd love to hear from you. Whether you want to volunteer, partner with us, or just learn more — reach out.",
  ),
};
const status = Astro.url.searchParams.get("status");
const isContactFormConfigured = isWixContactFormConfigured();
const hasContactStatus = ["sent", "missing", "error", "unavailable"].includes(status ?? "");
const shouldShowContactUnavailable =
  status === "unavailable" || (!isContactFormConfigured && !hasContactStatus);

const contactDescription = truncateDescription(hero.body);
---
<BaseLayout
  title="Contact — U COUNT Campaign"
  site={site}
  activePage="contact"
  meta={{
    description: contactDescription,
    canonicalPath: "/contact",
    schemaType: "ContactPage",
    ...resolveSocialImageMeta(heroContent),
    keywords: ["contact U COUNT", "volunteer anti-trafficking", "Fort Collins nonprofit"],
  }}
  structuredData={[
    breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Contact", path: "/contact" },
    ], siteUrl),
  ]}
>
  <!-- ===== PAGE HERO ===== -->
  <section class="bg-neutral-50 pt-28 lg:pt-32 pb-12 lg:pb-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-neutral-900 tracking-tight mb-4">
        {hero.title}
      </h1>
      <p class="text-lg text-neutral-600 max-w-2xl mx-auto leading-relaxed">
        {hero.body}
      </p>
    </div>
  </section>

  <!-- ===== CONTACT SECTION ===== -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">

        <!-- Left Column — Contact Information -->
        <div class="lg:col-span-2 bg-neutral-50 rounded-2xl p-8 lg:p-10 h-fit">
          <h2 class="font-display font-bold text-2xl text-neutral-900 mb-6">Contact Information</h2>

          <!-- Email -->
          <div class="flex items-start gap-4 mb-6">
            <div class="w-10 h-10 rounded-full bg-ember-50 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-ember-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-neutral-700 mb-1">Email</p>
              <a href={`mailto:${site.mainEmail}`} class="text-sm text-ember-brand hover:text-ember-600 transition-colors">{site.mainEmail}</a>
            </div>
          </div>

          <!-- Address -->
          <div class="flex items-start gap-4 mb-8">
            <div class="w-10 h-10 rounded-full bg-ember-50 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-ember-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-neutral-700 mb-1">Address</p>
              <p class="text-sm text-neutral-600 leading-relaxed">{site.streetAddress}<br/>{site.cityStateZip}</p>
            </div>
          </div>

          <!-- Social Links -->
          <div class="border-t border-neutral-200 pt-6">
            <p class="text-sm font-semibold text-neutral-700 mb-4">Follow Us</p>
            <SocialLinks site={site} variant="surface" />
          </div>
        </div>

        <!-- Right Column — Contact Form -->
        <div class="lg:col-span-3">
          <div class="bg-white rounded-2xl border border-neutral-100 shadow-sm p-8 lg:p-10">
            <h2 class="font-display font-bold text-2xl text-neutral-900 mb-6">Send Us a Message</h2>

            {status === "sent" && (
              <div data-contact-status-message class="mb-5 rounded-2xl border border-ember-200 bg-ember-50 px-5 py-4 text-sm font-semibold text-ember-700">
                Thanks for reaching out. Your message was submitted.
              </div>
            )}

            {status === "missing" && (
              <div data-contact-status-message class="mb-5 rounded-2xl border border-danger-200 bg-danger-50 px-5 py-4 text-sm font-semibold text-danger-500">
                Please include your first name, email, and message before sending.
              </div>
            )}

            {status === "error" && (
              <div data-contact-status-message class="mb-5 rounded-2xl border border-danger-200 bg-danger-50 px-5 py-4 text-sm font-semibold text-danger-500">
                Your message could not be submitted. Please try again or email us directly at <a href={`mailto:${site.mainEmail}`} class="underline decoration-danger-300 underline-offset-4 hover:text-danger-700">{site.mainEmail}</a>.
              </div>
            )}

            {shouldShowContactUnavailable && (
              <div data-contact-status-message class="mb-5 rounded-2xl border border-danger-200 bg-danger-50 px-5 py-4 text-sm font-semibold text-danger-500">
                The contact form is temporarily unavailable. Please email us directly at <a href={`mailto:${site.mainEmail}`} class="underline decoration-danger-300 underline-offset-4 hover:text-danger-700">{site.mainEmail}</a>.
              </div>
            )}

            <form data-contact-form action="/api/contact" method="POST" data-astro-reload class="space-y-5">
              <div class="hidden" aria-hidden="true">
                <label for="company">Company</label>
                <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="firstName" class="block text-sm font-medium text-neutral-700 mb-1.5">First Name</label>
                  <input type="text" id="firstName" name="firstName" required autocomplete="given-name"
                    class="w-full px-4 py-3 rounded-xl border border-neutral-200 text-sm text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-ember-brand focus:border-transparent transition-shadow" />
                </div>

                <div>
                  <label for="lastName" class="block text-sm font-medium text-neutral-700 mb-1.5">Last Name <span class="font-normal text-neutral-400">(optional)</span></label>
                  <input type="text" id="lastName" name="lastName" autocomplete="family-name"
                    class="w-full px-4 py-3 rounded-xl border border-neutral-200 text-sm text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-ember-brand focus:border-transparent transition-shadow" />
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-neutral-700 mb-1.5">Email</label>
                <input type="email" id="email" name="email" required autocomplete="email"
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 text-sm text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-ember-brand focus:border-transparent transition-shadow" />
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-neutral-700 mb-1.5">Message</label>
                <textarea id="message" name="message" rows="6" required
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 text-sm text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-ember-brand focus:border-transparent transition-shadow resize-vertical"></textarea>
              </div>

              <button type="submit" disabled={!isContactFormConfigured}
                class:list={[
                  "w-full px-6 py-3.5 font-display font-semibold text-sm rounded-full transition-colors",
                  isContactFormConfigured
                    ? "bg-ember-brand text-white hover:bg-ember-500 shadow-lg shadow-ember-brand/25"
                    : "cursor-not-allowed bg-neutral-200 text-neutral-500",
                ]}>
                {isContactFormConfigured ? "Send Message" : "Contact Form Unavailable"}
              </button>
            </form>

            <p class="text-xs text-neutral-500 mt-4 text-center">
              You can also email us directly at <a href={`mailto:${site.mainEmail}`} class="text-ember-brand hover:text-ember-600 transition-colors">{site.mainEmail}</a>
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <script define:vars={{ hasContactStatus }}>
    if (hasContactStatus && window.history.replaceState) {
      const url = new URL(window.location.href);
      url.searchParams.delete("status");

      const search = url.searchParams.toString();
      const cleanUrl = `${url.pathname}${search ? `?${search}` : ""}${url.hash}`;

      window.history.replaceState(window.history.state, "", cleanUrl);
    }

    if (hasContactStatus) {
      const form = document.querySelector("[data-contact-form]");
      const statusMessage = document.querySelector("[data-contact-status-message]");

      form?.addEventListener("input", () => statusMessage?.remove(), { once: true });
    }
  </script>
</BaseLayout>
