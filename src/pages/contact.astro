---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  cmsText,
  getPageSection,
  getSiteSettings,
  resolveSiteSettings,
} from "../lib/wix-cms";

const [siteSettings, heroContent] = await Promise.all([
  getSiteSettings(),
  getPageSection("contact", "hero"),
]);

const site = resolveSiteSettings(siteSettings);

const hero = {
  title: cmsText(heroContent?.title, "Get In Touch"),
  body: cmsText(
    heroContent?.body,
    "We'd love to hear from you. Whether you want to volunteer, partner with us, or just learn more — reach out.",
  ),
};
---
<BaseLayout title="Contact — U COUNT Campaign" site={site} activePage="contact">
  <!-- ===== PAGE HERO ===== -->
  <section class="bg-neutral-50 pt-28 lg:pt-32 pb-12 lg:pb-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-neutral-900 tracking-tight mb-4">
        {hero.title}
      </h1>
      <p class="text-lg text-neutral-600 max-w-2xl mx-auto leading-relaxed">
        {hero.body}
      </p>
    </div>
  </section>

  <!-- ===== CONTACT SECTION ===== -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">

        <!-- Left Column — Contact Information -->
        <div class="lg:col-span-2 bg-neutral-50 rounded-2xl p-8 lg:p-10 h-fit">
          <h2 class="font-display font-bold text-2xl text-neutral-900 mb-6">Contact Information</h2>

          <!-- Email -->
          <div class="flex items-start gap-4 mb-6">
            <div class="w-10 h-10 rounded-full bg-ember-50 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-ember-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-neutral-700 mb-1">Email</p>
              <a href={`mailto:${site.mainEmail}`} class="text-sm text-ember-brand hover:text-ember-600 transition-colors">{site.mainEmail}</a>
            </div>
          </div>

          <!-- Address -->
          <div class="flex items-start gap-4 mb-8">
            <div class="w-10 h-10 rounded-full bg-ember-50 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-ember-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-neutral-700 mb-1">Address</p>
              <p class="text-sm text-neutral-600 leading-relaxed">{site.streetAddress}<br/>{site.cityStateZip}</p>
            </div>
          </div>

          <!-- Social Links -->
          <div class="border-t border-neutral-200 pt-6">
            <p class="text-sm font-semibold text-neutral-700 mb-4">Follow Us</p>
            <div class="flex items-center gap-3">
              <a href={site.facebookUrl} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white hover:bg-ember-brand/10 border border-neutral-200 flex items-center justify-center transition-colors group">
                <svg class="w-5 h-5 text-neutral-500 group-hover:text-ember-brand transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white hover:bg-ember-brand/10 border border-neutral-200 flex items-center justify-center transition-colors group">
                <svg class="w-5 h-5 text-neutral-500 group-hover:text-ember-brand transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column — Contact Form -->
        <div class="lg:col-span-3">
          <div class="bg-white rounded-2xl border border-neutral-100 shadow-sm p-8 lg:p-10">
            <h2 class="font-display font-bold text-2xl text-neutral-900 mb-6">Send Us a Message</h2>

            <form action="https://formspree.io/f/PLACEHOLDER" method="POST" class="space-y-5">
              <!-- Name -->
              <div>
                <label for="name" class="block text-sm font-medium text-neutral-700 mb-1.5">Name</label>
                <input type="text" id="name" name="name" required placeholder="Your full name"
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 text-sm text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-ember-brand focus:border-transparent transition-shadow" />
              </div>

              <!-- Email -->
              <div>
                <label for="email" class="block text-sm font-medium text-neutral-700 mb-1.5">Email</label>
                <input type="email" id="email" name="email" required placeholder="you@example.com"
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 text-sm text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-ember-brand focus:border-transparent transition-shadow" />
              </div>

              <!-- Subject -->
              <div>
                <label for="subject" class="block text-sm font-medium text-neutral-700 mb-1.5">Subject</label>
                <select id="subject" name="subject" required
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 text-sm text-neutral-900 focus:outline-none focus:ring-2 focus:ring-ember-brand focus:border-transparent transition-shadow appearance-none bg-white bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%239E9E9E%22%20d%3D%22M6%208L1%203h10z%22%2F%3E%3C%2Fsvg%3E')] bg-[length:12px] bg-[right_16px_center] bg-no-repeat">
                  <option value="" disabled selected>Select a subject</option>
                  <option value="General Inquiry">General Inquiry</option>
                  <option value="Volunteer">Volunteer</option>
                  <option value="Partnership">Partnership</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <!-- Message -->
              <div>
                <label for="message" class="block text-sm font-medium text-neutral-700 mb-1.5">Message</label>
                <textarea id="message" name="message" rows="5" required placeholder="How can we help?"
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 text-sm text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-ember-brand focus:border-transparent transition-shadow resize-vertical"></textarea>
              </div>

              <!-- Submit -->
              <button type="submit"
                class="w-full px-6 py-3.5 bg-ember-brand text-white font-display font-semibold text-sm rounded-full hover:bg-ember-500 transition-colors shadow-lg shadow-ember-brand/25">
                Send Message
              </button>
            </form>

            <p class="text-xs text-neutral-500 mt-4 text-center">
              You can also email us directly at <a href={`mailto:${site.mainEmail}`} class="text-ember-brand hover:text-ember-600 transition-colors">{site.mainEmail}</a>
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
