---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { ResolvedSiteSettings } from "../lib/wix-cms";

type ActivePage = "home" | "about" | "contact" | "shop";

const { title, site, activePage } = Astro.props as {
  title: string;
  site: ResolvedSiteSettings;
  activePage: ActivePage;
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" href="/assets/ucount-logo-favicon.svg" type="image/svg+xml" />
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ember: {
              50: '#FFEFE6', 100: '#FFD3BA', 200: '#FAB38B', 300: '#EF8E58',
              400: '#E67635', brand: '#F38720', 500: '#C65D21', 600: '#AB4E19',
              700: '#8C3D10', 800: '#77340D', 900: '#572508',
            },
            neutral: {
              50: '#F7F7F7', 100: '#E1E1E1', 200: '#CFCFCF', 300: '#B1B1B1',
              400: '#9E9E9E', 500: '#7E7E7E', 600: '#626262', 700: '#515151',
              800: '#3B3B3B', 900: '#222222',
            },
            sky: {
              50: '#EBF8FF', 100: '#D1EEFC', 200: '#A7D8F0', 300: '#7CC1E4',
              400: '#55AAD4', 500: '#3994C1', 600: '#2D83AE', 700: '#1D6F98',
              800: '#166086', 900: '#0B4F71',
            },
            gold: {
              50: '#FFFAEB', 100: '#FCEFC7', 200: '#F8E3A3', 300: '#F9DA8B',
              400: '#F7D070', 500: '#E9B949', 600: '#C99A2E', 700: '#A27C1A',
              800: '#7C5E10', 900: '#513C06',
            },
            danger: {
              50: '#FFEEEE', 100: '#FACDCD', 200: '#F29B9B', 300: '#E66A6A',
              400: '#D64545', 500: '#BA2525',
            },
          },
          fontFamily: {
            display: ['"Clash Display"', 'system-ui', 'sans-serif'],
            body: ['"Satoshi"', 'system-ui', 'sans-serif'],
          },
        },
      },
    }
  </script>
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link href="https://api.fontshare.com/v2/css?f[]=clash-display@200,300,400,500,600,700&f[]=satoshi@300,400,500,700&display=swap" rel="stylesheet" />
  <style is:global>
    * { font-family: 'Satoshi', system-ui, sans-serif; }

    html { scroll-behavior: smooth; }

    .nav-link {
      position: relative;
    }
    .nav-link::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 0;
      height: 2px;
      background: #F38720;
      transition: width 0.3s ease;
    }
    .nav-link:hover::after,
    .nav-link[aria-current="page"]::after {
      width: 100%;
    }

    .mobile-menu {
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .mobile-menu.open {
      transform: translateX(0);
    }

    details summary::-webkit-details-marker { display: none; }
    details summary::marker { display: none; }
    details summary { list-style: none; }
    details[open] summary .chevron-icon { transform: rotate(180deg); }

    .ui-input,
    .ui-select-trigger {
      width: 100%;
      border: 1px solid #CFCFCF;
      background: #fff;
      color: #222222;
      font-size: 0.875rem;
      line-height: 1.25rem;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

    .ui-select-trigger,
    .ui-select-option,
    .ui-page-button {
      cursor: pointer;
      font: inherit;
    }

    .ui-input {
      padding: 0 1rem;
    }

    .ui-input::placeholder {
      color: #9E9E9E;
    }

    .ui-input:focus,
    .ui-select-trigger:focus-visible {
      border-color: #F38720;
      outline: none;
      box-shadow: 0 0 0 3px rgba(243, 135, 32, 0.18);
    }

    .ui-input:disabled,
    .ui-select-trigger:disabled {
      cursor: not-allowed;
      background: #F7F7F7;
      color: #9E9E9E;
    }

    .ui-select-trigger {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0 1rem;
      text-align: left;
    }

    .ui-select-menu {
      position: absolute;
      z-index: 40;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      max-height: 18rem;
      overflow: auto;
      border: 1px solid #CFCFCF;
      border-radius: 0.875rem;
      background: #fff;
      padding: 0.35rem;
      box-shadow: 0 18px 45px rgba(34, 34, 34, 0.14);
    }

    .ui-select-option {
      display: flex;
      min-height: 2.25rem;
      width: 100%;
      align-items: center;
      border-radius: 0.625rem;
      padding: 0.5rem 0.75rem;
      color: #3B3B3B;
      font-size: 0.875rem;
      line-height: 1.25rem;
      text-align: left;
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .ui-select-option:hover,
    .ui-select-option:focus-visible,
    .ui-select-option[aria-selected="true"] {
      background: #FFEFE6;
      color: #8C3D10;
      outline: none;
    }

    .ui-select-option[data-option-in-stock="false"] {
      color: #9E9E9E;
    }

    .ui-select-option[data-option-in-stock="false"][aria-selected="true"] {
      background: #FFEEEE;
      color: #BA2525;
    }

    .ui-page-button {
      min-width: 2.5rem;
      height: 2.5rem;
      border: 1px solid #CFCFCF;
      border-radius: 999px;
      background: #fff;
      padding: 0 0.9rem;
      color: #3B3B3B;
      font-size: 0.875rem;
      font-weight: 700;
      transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    }

    .ui-page-button:hover:not(:disabled),
    .ui-page-button:focus-visible,
    .ui-page-button.is-active {
      border-color: #222222;
      background: #222222;
      color: #fff;
      outline: none;
    }

    .ui-page-button:disabled {
      cursor: not-allowed;
      opacity: 0.45;
    }

    .price-range {
      --price-lower: 0%;
      --price-upper: 100%;
      position: relative;
      height: 2rem;
      display: flex;
      align-items: center;
    }

    .price-range-track,
    .price-range-fill {
      position: absolute;
      left: 0;
      right: 0;
      height: 0.375rem;
      border-radius: 999px;
    }

    .price-range-track {
      background: #E1E1E1;
    }

    .price-range-fill {
      left: var(--price-lower);
      right: calc(100% - var(--price-upper));
      background: #F38720;
      box-shadow: 0 5px 14px rgba(243, 135, 32, 0.2);
    }

    .price-range-input {
      position: absolute;
      inset: 0;
      width: 100%;
      margin: 0;
      background: transparent;
      pointer-events: none;
      -webkit-appearance: none;
      appearance: none;
    }

    .price-range-input:focus {
      outline: none;
    }

    .price-range-input::-webkit-slider-runnable-track {
      height: 0.375rem;
      background: transparent;
    }

    .price-range-input::-moz-range-track {
      height: 0.375rem;
      background: transparent;
    }

    .price-range-input::-webkit-slider-thumb {
      width: 1.25rem;
      height: 1.25rem;
      margin-top: -0.4375rem;
      border: 3px solid #fff;
      border-radius: 999px;
      background: #626262;
      box-shadow: 0 2px 7px rgba(34, 34, 34, 0.28);
      cursor: grab;
      pointer-events: auto;
      -webkit-appearance: none;
      appearance: none;
    }

    .price-range-input::-moz-range-thumb {
      width: 1.25rem;
      height: 1.25rem;
      border: 3px solid #fff;
      border-radius: 999px;
      background: #626262;
      box-shadow: 0 2px 7px rgba(34, 34, 34, 0.28);
      cursor: grab;
      pointer-events: auto;
    }

    .price-range-input:focus-visible::-webkit-slider-thumb {
      box-shadow: 0 0 0 4px rgba(243, 135, 32, 0.18), 0 2px 7px rgba(34, 34, 34, 0.28);
    }

    .price-range-input:focus-visible::-moz-range-thumb {
      box-shadow: 0 0 0 4px rgba(243, 135, 32, 0.18), 0 2px 7px rgba(34, 34, 34, 0.28);
    }

    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
      margin: 0;
      -webkit-appearance: none;
    }

    input[type="number"] {
      -moz-appearance: textfield;
    }

    @keyframes fade-up {
      from { opacity: 0; transform: translateY(32px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .fade-up {
      animation: fade-up 0.7s ease-out both;
    }
  </style>
  <slot name="head" />
</head>
<body class="bg-white text-neutral-900 overflow-x-hidden">
  <Header site={site} activePage={activePage} />
  <slot />
  <Footer site={site} activePage={activePage} />
</body>
</html>
