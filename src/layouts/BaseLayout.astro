---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Cart from "../components/Cart.astro";
import type { ResolvedSiteSettings } from "../lib/wix-cms";
import {
  absoluteUrl,
  DEFAULT_SOCIAL_IMAGE,
  DEFAULT_SOCIAL_IMAGE_ALT,
  getSiteUrl,
  organizationSchema,
  safeJsonLd,
  SOCIAL_IMAGE_HEIGHT,
  SOCIAL_IMAGE_WIDTH,
  type SeoMeta,
  truncateDescription,
  webPageSchema,
  websiteSchema,
} from "../lib/seo";
import "../styles/global.css";

type ActivePage = "home" | "about" | "contact" | "events" | "shop";

const { title, site, activePage, meta, structuredData = [] } = Astro.props as {
  title: string;
  site: ResolvedSiteSettings;
  activePage: ActivePage;
  meta?: SeoMeta;
  structuredData?: unknown[];
};

const description = truncateDescription(
  meta?.description || site.organizationSummary,
);
const canonicalPath = meta?.canonicalPath || Astro.url.pathname;
const siteUrl = getSiteUrl(Astro.url.origin);
const canonicalUrl = absoluteUrl(canonicalPath, siteUrl);
const imageUrl = absoluteUrl(meta?.image || DEFAULT_SOCIAL_IMAGE, siteUrl);
const imageAlt = meta?.imageAlt || DEFAULT_SOCIAL_IMAGE_ALT;
const imageWidth = meta?.imageWidth ?? SOCIAL_IMAGE_WIDTH;
const imageHeight = meta?.imageHeight ?? SOCIAL_IMAGE_HEIGHT;
const robots = meta?.noindex ? "noindex, nofollow" : "index, follow";
const jsonLd = [
  organizationSchema(site, siteUrl),
  websiteSchema(site, siteUrl),
  webPageSchema({
    title,
    description,
    path: canonicalPath,
    schemaType: meta?.schemaType,
    siteUrl,
  }),
  ...structuredData,
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  {meta?.keywords?.length && <meta name="keywords" content={meta.keywords.join(", ")} />}
  <link rel="canonical" href={canonicalUrl} />
  <meta name="theme-color" content="#a9461f" />
  <meta name="application-name" content={site.siteName} />
  <meta name="format-detection" content="telephone=no" />
  <meta property="og:site_name" content={site.siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={meta?.type || "website"} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:secure_url" content={imageUrl} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:image:width" content={String(imageWidth)} />
  <meta property="og:image:height" content={String(imageHeight)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/assets/ucount-logo-favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
  <link rel="preload" href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=satoshi@400,500,700&display=swap" as="style" />
  <link href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=satoshi@400,500,700&display=swap" rel="stylesheet" />
  <ClientRouter />
  {jsonLd.map((schema) => (
    <script type="application/ld+json" set:html={safeJsonLd(schema)} />
  ))}
  <slot name="head" />
</head>
<body class="bg-white text-neutral-900 overflow-x-hidden">
  <Header site={site} activePage={activePage} />
  <slot />
  <Footer site={site} activePage={activePage} />
  <Cart />
</body>
</html>
